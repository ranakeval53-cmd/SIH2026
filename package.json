{
  "name": "trackshield-ai",
  "version": "2.0.0",
  "description": "TrackShield AI — AI-Powered Railway Block Planning & Asset Availability Platform for Indian Railways",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run dev",
    "preview": "npm --prefix frontend run preview",
    "test": "pytest",
    "install:all": "npm --prefix frontend install",
    "run:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "run:ai": "python -m backend.app.services.run_ai",
    "pipeline": "python src/data_pipeline.py"
  },
  "author": "TrackShield AI Operations",
  "license": "MIT"
}
